###############################################################################
# Set default behavior to automatically normalize line endings.
###############################################################################
* text=auto eol=lf

*.cs text eol=lf
*.xaml text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf
*.resw text eol=lf
*.ini text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.bat text eol=lf
*.cmd text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

###############################################################################
# Binary files
###############################################################################
*.png binary
*.ico binary
*.jpg binary
*.gif binary
*.zip binary
*.exe binary
*.dll binary
*.pri binary
*.xbf binary
*.db binary
*.sqlite binary
